# ---------------------------------------------------------------------------
# TideCloak master-admin credentials — LOCAL DEVELOPMENT ONLY
#
# Copy this file to `.env` and set a value. `.env` is gitignored; this example
# is not, so never put a real secret HERE.
#
#   cp .env.example .env
#   $EDITOR .env          # set KC_BOOTSTRAP_ADMIN_PASSWORD
#
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# === Tide licence email + Terms & Conditions ===============================
#   https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# === TideCloak Server & Realm Configuration ================================
TIDECLOAK_URL=http://localhost:8080
REALM_NAME=casebridge
CLIENT_NAME=casebridge-client
CLIENT_APP_URL=http://localhost:3000

# === CaseBridge Application Settings =======================================
DATABASE_PATH=./data/casebridge.db
PRIVATE_STORAGE_DIR=./data/private-storage
INVITATION_TTL_SECONDS=60

# === AI Provider Configuration =============================================
# Optional: set OPENAI_API_KEY or GEMINI_API_KEY for live structured LLM calls.
# When omitted, CaseBridge uses deterministic Fixture Adapter ("AI mô phỏng").
AI_MODE=fixture
OPENAI_API_KEY=
GEMINI_API_KEY=
